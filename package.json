{
  "name": "prezent-mapy",
  "private": true,
  "description": "Rodzinne zdjęcia i podróże na mapie — aplikacja Windows",
  "author": "eskejtpro",
  "version": "1.3.1",
  "engines": {
    "node": ">=24 <27"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "desktop": "npm run build && electron .",
    "package:windows": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "test:tooling": "node --test tests/tooling.test.mjs",
    "test:database": "node --test tests/database.test.cjs tests/media-store.test.cjs tests/offline-map.test.cjs",
    "test:integration": "vitest run src/__tests__/storage.integration.test.ts",
    "verify": "node scripts/verify.mjs",
    "project:check": "node scripts/project-check.mjs",
    "hooks:install": "git config --local core.hooksPath .githooks",
    "release:check": "node scripts/release-check.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run src/__tests__"
  },
  "build": {
    "appId": "pl.eskejtpro.prezentmapy",
    "productName": "Prezent Mapy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Prezent-Mapy-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Prezent-Mapy-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
